# Tamurt Jobs — runtime settings of the production server (Iglao).
# Copy to /etc/tamurt-jobs/env on the server (chown root:tamurt, chmod 640) and fill in.
# NEVER commit the filled file. The NEXT_PUBLIC_* values are fixed at build time: they are set
# as GitHub "variables" of the "production" environment (see deploy/iglao/README.md).

APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://jobs.example.com
# Nginx overwrites X-Real-IP with the visitor's address.
CLIENT_IP_HEADER=x-real-ip

# Supabase (production project)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stripe (live mode, after the owner's approval)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false

# E-mails (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Tamurt Jobs <no-reply@example.com>"
EMAIL_REPLY_TO=

# Scheduled jobs (also read by bin/run-cron.sh). Generate: openssl rand -hex 32
CRON_SECRET=

# Anti-robot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Advertising and error monitoring (optional)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_SENTRY_DSN=

# Company registries
REGISTRY_FR_ENABLED=true
REGISTRY_VIES_ENABLED=true
