# =============================================================================
# Tamurt Jobs — environment variables (TEMPLATE: no secret in this file)
# Copy to .env.local for local development. In production, set them in the
# hosting provider (Vercel → Project → Settings → Environment Variables).
# Local development values can be generated: npm run supabase:start && npm run test:env -- --app
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Public canonical URL (used in e-mails, Stripe return URLs, sitemap, canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tamurt Services (parent company) address, optional. When set, the red yaz button at the
# top right links back to all Tamurt apps. Empty: no button.
TAMURT_SERVICES_URL=
# Set by Vercel automatically (production | preview | development). Outside Vercel,
# set APP_ENV=production on the production deployment so that production guards apply.
# APP_ENV=production

# --- Supabase (Postgres, Auth, private Storage) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key: safe for the browser, every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key: SERVER ONLY. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Stripe (Checkout + Billing, one subscription per active advert) -----------
# Production MUST use live keys (sk_live_… / rk_live_…): with a test key, checkout is
# refused on the production deployment and test-mode webhook events are ignored.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# true only once Stripe Tax is configured (registrations per country) in the Stripe dashboard.
STRIPE_AUTOMATIC_TAX=false
# Product name shown on Stripe Checkout and invoices.
STRIPE_PRODUCT_NAME="Tamurt Jobs — annonce d'emploi (abonnement mensuel)"

# --- Transactional e-mail -------------------------------------------------------
# resend | smtp | none ("none" queues e-mails without sending them; the admin dashboard reports it).
EMAIL_PROVIDER=none
# Sender on a domain verified with the provider (SPF, DKIM, DMARC).
EMAIL_FROM="Tamurt Jobs <no-reply@example.com>"
EMAIL_REPLY_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- Scheduled jobs ----------------------------------------------------------------
# Random string (32+ characters). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Anti-bot (Cloudflare Turnstile) -----------------------------------------------
# Without these keys forms work without a captcha (local development); rate limits still apply and the
# admin dashboard flags it in production. Sign-up/login tokens are verified by Supabase Auth: also enable
# Turnstile in Supabase (Authentication → Bot and Abuse Protection) with the same secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Company registries (automatic checks; otherwise manual review) ----------------
# France: API Recherche d'entreprises (public, no key).
REGISTRY_FR_ENABLED=true
# EU VAT numbers: VIES (public, no key).
REGISTRY_VIES_ENABLED=true
# United Kingdom: Companies House API key (free registration on developer.company-information.service.gov.uk).
COMPANIES_HOUSE_API_KEY=
# Switzerland: Zefix REST API credentials (on request from the Federal Office of Justice).
ZEFIX_USERNAME=
ZEFIX_PASSWORD=
# United States / Canada: OpenCorporates API token (paid licence required for commercial use).
OPENCORPORATES_API_TOKEN=
REGISTRY_HTTP_TIMEOUT_MS=8000

LOG_LEVEL=info
