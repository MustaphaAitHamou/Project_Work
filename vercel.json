{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "7 3 * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "35 5 * * *"
    }
  ]
}
